{
  "manifest_version": 3,
  "name": "YT Music Mix-Analyse",
  "version": "1.1.0",
  "description": "Analysiert YouTube-Music-Playlists (BPM, Tonart, Camelot, Takt, Energie) und sortiert sie nach Übergangspassung.",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_title": "Playlist analysieren", "default_icon": { "16": "icons/16.png", "48": "icons/48.png" } },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "unlimitedStorage", "tabs"],
  "host_permissions": [
    "https://music.youtube.com/*"
  ],
  "content_scripts": [
    { "matches": ["https://music.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle" },
    { "matches": ["https://music.youtube.com/*"], "js": ["bridge.js"], "run_at": "document_idle", "world": "MAIN" }
  ]
}
